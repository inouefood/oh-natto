"NOTIFICATION.TITLE" = "วันนี้เป็นวันนัตโตะ!";
"NOTIFOCATION.MESSAGE" = "อยากจะคลุกนัตโตะด้วย oh! natto! ไหม?";
"UPDATEALERT.MESSAGE" = "มีเวอร์ชันใหม่ให้อัปเดตแล้ว";
