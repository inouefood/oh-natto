"TIPS.0" = "ว่ากันว่านัตโตะมีอยู่แล้วตั้งแต่ยุคยาโยอิ!";
"TIPS.1" = "นัตโตะแพร่หลายในหมู่ประชาชนทั่วไปในยุคเอโดะ";
"TIPS.2" = "คำว่านัตโตะปรากฏในเอกสารครั้งแรกในยุคเฮอัน";
"TIPS.3" = "นัตโตะมี 2 ประเภทหลัก คือ «อิโตะฮิกิ-นัตโตะ» และ «ชิโอะคาระ-นัตโตะ»";
"TIPS.4" = "นัตโตะมีสารอาหารที่ถั่วต้มทั่วไปไม่มี!";
"TIPS.5" = "ว่ากันว่านัตโตะมีแบคทีเรียนัตโตะประมาณ 1,000 ล้านตัวต่อกรัม!";
"TIPS.6" = "ถ้าเรียงแบคทีเรียในนัตโตะ 1 กรัมเป็นแถว จะยาวถึง 1,000 กิโลเมตร!";
"TIPS.7" = "แบคทีเรียนัตโตะมีพลังชีวิตสูงมากจนไม่ตายแม้สัมผัสถั่วที่เพิ่งต้มสุก";
"TIPS.8" = "ความเหนียวช่วยดูดซับน้ำและมีแนวคิดว่าอาจทำให้ทะเลทรายเขียวขจีได้";
"TIPS.9" = "ว่ากันว่ากลิ่นของนัตโตะมีองค์ประกอบถึง 68 ชนิด!";
"TIPS.10" = "คลุกนัตโตะ 400 ครั้งแล้วจะอร่อยมาก!";
"TIPS.11" = "นัตโตะกับไข่ขาวไม่เข้ากัน กินพร้อมกันจะทำให้ผลการบำรุงผิวหายไป";
"TIPS.12" = "ฤดูกาลที่ดีที่สุดสำหรับนัตโตะคือมกราคมถึงมีนาคม";
"TIPS.13" = "คุณมีตะเกียบสำหรับคลุกนัตโตะโดยเฉพาะไหม?";
"TIPS.14" = "จังหวัดฟุกุชิมะเป็นจังหวัดที่กินนัตโตะมากที่สุดในญี่ปุ่น";
"TIPS.15" = "ในอินโดนีเซียมีอาหารที่เรียกว่าเทมเป้ ซึ่งคล้ายกับนัตโตะมาก";
"TIPS.16" = "นัตโตะไคเนส ซึ่งเป็นส่วนประกอบในความเหนียวของนัตโตะ สามารถละลายลิ่มเลือดได้";
"TIPS.17" = "ว่ากันว่านัตโตะอุดมด้วยวิตามินเค 2 ช่วยเสริมสร้างกระดูก";
"TIPS.18" = "ว่ากันว่าจังหวัดอิบารากิเป็นจังหวัดที่ผลิตนัตโตะมากที่สุดในญี่ปุ่น";
"TIPS.19" = "มีการพิสูจน์แล้วว่าแบคทีเรียนัตโตะสามารถมีชีวิตอยู่ได้แม้แต่ในอวกาศ!";
"TIPS.20" = "จริงๆ แล้วเก็บในช่องแช่แข็งได้ ละลายแล้วก็ยังอร่อยนะ!";
"TIPS.21" = "นัตโตะ 1 แพ็กมีถั่วประมาณ 50 ถึง 60 เม็ด!";
"TIPS.22" = "อุ่นแล้วจะยืดเส้นได้ง่ายขึ้น!";
"TIPS.23" = "น่าแปลกที่นัตโตะมีแคลอรีต่ำมาก เหมาะสำหรับการลดน้ำหนักด้วย!";
"TIPS.24" = "ที่เมืองมิโตะมีศาลเจ้านัตโตะอยู่!";
